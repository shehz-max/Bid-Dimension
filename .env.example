# Bid Dimensions SMTP Configuration for Form Submissions
# Email destination: info@biddimensions.us

# SMTP Server Host (e.g., smtp.gmail.com, smtp.zoho.com, smtp.office365.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Auth Credentials
SMTP_USER=info@biddimensions.us
SMTP_PASS=your-app-password-here

# Target recipient for incoming quotes (defaults to info@biddimensions.us if omitted)
CONTACT_EMAIL=info@biddimensions.us
