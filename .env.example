# ==========================================
# BID DIMENSIONS - FORM & EMAIL CONFIGURATION
# ==========================================
# Create a file named .env.local in the root directory and paste your values.

# ------------------------------------------
# Option 1: Gmail / Google Workspace (Recommended)
# ------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-google-app-password

# ------------------------------------------
# Option 2: Domain Webmail (cPanel / Titan / Namecheap)
# ------------------------------------------
SMTP_HOST=mail.biddimensions.us
SMTP_PORT=465
SMTP_USER=info@biddimensions.us
SMTP_PASS=YourEmailPasswordHere

# ------------------------------------------
# Recipient Email for Lead Notifications:
# ------------------------------------------
CONTACT_EMAIL=info@biddimensions.us
